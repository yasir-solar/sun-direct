16:[["$","section",null,{"className":"page-hero","children":["$","div",null,{"className":"container","children":[["$","p",null,{"className":"kicker light","children":"Sun Direct Renewable - Alberta"}],["$","h1",null,{"children":"How a Grid-Connected Solar System Works"}],["$","p",null,{"children":"Solar panels convert daylight into electricity for your property. An inverter makes that energy usable, while monitoring helps you understand performance."}]]}]}],["$","nav",null,{"className":"breadcrumbs container","aria-label":"Breadcrumb","children":[["$","$L8",null,{"href":"/","children":"Home"}],["$","span",null,{"children":"/"}],["$","span",null,{"aria-current":"page","children":"How a Grid-Connected Solar System Works"}]]}],["$","div",null,{"className":"page-feature-image container","children":["$","$L9",null,{"src":"/media/installations/system-equipment.webp","alt":"Exterior solar electrical equipment installed below rooftop panels","fill":true,"sizes":"(max-width:760px) 100vw, 1280px"}]}],["$","section",null,{"className":"section","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"content-sections","children":[["$","article","From sunlight to usable power",{"className":"content-card","children":[["$","h2",null,{"children":"From sunlight to usable power"}],["$","p",null,{"children":"Panels produce direct-current electricity. An inverter converts it to alternating current for your home, business or farm."}],"$undefined","$undefined"]}],["$","article","Use, export and monitor",{"className":"content-card","children":[["$","h2",null,{"children":"Use, export and monitor"}],["$","p",null,{"children":"Your property uses solar electricity as it is produced. Depending on approvals and arrangements, surplus may flow to the grid and appear as a credit."}],"$undefined","$undefined"]}],["$","article","Design matters",{"className":"content-card","children":[["$","h2",null,{"children":"Design matters"}],["$","p",null,{"children":"Orientation, shading, weather, equipment, losses and actual electricity use all affect the annual result. A professional model explains its assumptions."}],"$undefined","$undefined"]}]]}]}]}],["$","section",null,{"className":"section section-soft","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"section-heading center","children":[["$","p",null,{"className":"kicker","children":"Frequently asked questions"}],["$","h2",null,{"children":"What to know about solar"}],"$undefined"]}],["$","$L1f",null,{"items":[{"question":"Does my property use solar power before electricity from the grid?","answer":"A grid-connected property generally uses solar electricity as it is produced, with the grid supplying additional power when demand is higher than solar production."},{"question":"What does the inverter do?","answer":"Panels produce direct-current electricity. The inverter converts it into alternating current that the property can use and also provides operating and monitoring information."},{"question":"Why does actual production change from month to month?","answer":"Day length, weather, temperature, snow, shading and household or business conditions vary throughout the year. Annual estimates are more useful than expecting equal monthly production."},{"question":"Can I see how much electricity my panels are producing?","answer":"Most modern systems include monitoring. The exact information and access depend on the selected inverter and platform, and monitoring should be set up during commissioning."},{"question":"Does the system need regular manual operation?","answer":"Normally, no. A commissioned grid-connected system operates automatically, while monitoring helps identify unusual performance or equipment alerts that may need attention."}]}]]}]}],["$","section",null,{"className":"final-cta","children":[["$","div",null,{"className":"cta-orbit","aria-hidden":"true"}],["$","div",null,{"className":"container","children":[["$","div",null,{"children":[["$","p",null,{"className":"kicker light","children":"Your next step"}],"$L20","$L21"]}],"$L22"]}]]}],"$L23","$L24"]
